-- 1. TABLA: dato_cliente
CREATE TABLE dato_cliente (
    c_id_cliente      NUMBER NOT NULL,
    c_nombre_cliente  VARCHAR2(100) NOT NULL,
    c_direccion_envio VARCHAR2(200) NOT NULL,
    c_ciudad           VARCHAR2(100) NOT NULL,
    CONSTRAINT pk_dato_cliente PRIMARY KEY (c_id_cliente)
);

-- 2. TABLA: dato_item
CREATE TABLE dato_item (
    i_id_item            NUMBER NOT NULL,
    i_descripcion_pieza  VARCHAR2(255) NOT NULL,
    i_estado_conservacion VARCHAR2(50) NOT NULL,
    i_material_principal VARCHAR2(100) NOT NULL,
    CONSTRAINT pk_dato_item PRIMARY KEY (i_id_item),
    CONSTRAINT chk_estado_conservacion CHECK (i_estado_conservacion IN ('Casi Nuevo', 'Buen estado', 'Con desgaste'))
);

-- 3. TABLA: canal_venta
CREATE TABLE canal_venta (
    v_id_plataforma NUMBER NOT NULL,
    v_plataforma    VARCHAR2(50) NOT NULL,
    v_tipo_atencion VARCHAR2(100) NOT NULL,
    CONSTRAINT pk_canal_venta PRIMARY KEY (v_id_plataforma)
);

-- 4. TABLA HECHOS / TRANSACCIONAL: kardex_moda_circular
CREATE TABLE kardex_moda_circular (
    kd_id_orden     NUMBER NOT NULL,
    kd_id_cliente   NUMBER NOT NULL,
    kd_id_item      NUMBER NOT NULL,
    kd_id_canal     NUMBER NOT NULL,
    kd_fecha_pedido DATE NOT NULL,
    kd_precio_venta NUMBER(12, 2) NOT NULL,
    kd_costo_envio  NUMBER(12, 2) DEFAULT 0 NOT NULL,
    -- Campo calculado dinámicamente o expresado con suma simple
    kd_total_pagado NUMBER(12, 2) GENERATED ALWAYS AS (kd_precio_venta + kd_costo_envio),
    
    -- Restricciones de Claves Primarias y Foráneas (Diagrama E-R)
    CONSTRAINT pk_kardex_moda_circular PRIMARY KEY (kd_id_orden),
    CONSTRAINT fk_kardex_cliente FOREIGN KEY (kd_id_cliente) REFERENCES dato_cliente(c_id_cliente),
    CONSTRAINT fk_kardex_item FOREIGN KEY (kd_id_item) REFERENCES dato_item(i_id_item),
    CONSTRAINT fk_kardex_canal FOREIGN KEY (kd_id_canal) REFERENCES canal_venta(v_id_plataforma),
    
    -- Restricción de Regla de Negocio
    CONSTRAINT chk_precio_venta CHECK (kd_precio_venta > 0)
);

-- 1. Eliminar tablas previas (en orden inverso por llaves foráneas)
DROP TABLE kardex_moda_circular CASCADE CONSTRAINTS;
DROP TABLE canal_venta CASCADE CONSTRAINTS;
DROP TABLE dato_item CASCADE CONSTRAINTS;
DROP TABLE dato_cliente CASCADE CONSTRAINTS;

-- 2. Creación con propiedad IDENTITY
CREATE TABLE dato_cliente (
    c_id_cliente       NUMBER GENERATED BY DEFAULT AS IDENTITY,
    c_nombre_cliente   VARCHAR2(100) NOT NULL,
    c_direccion_envio  VARCHAR2(200) NOT NULL,
    c_ciudad           VARCHAR2(100) NOT NULL,
    CONSTRAINT pk_dato_cliente PRIMARY KEY (c_id_cliente)
);

CREATE TABLE dato_item (
    i_id_item             NUMBER GENERATED BY DEFAULT AS IDENTITY,
    i_descripcion_pieza   VARCHAR2(255) NOT NULL,
    i_estado_conservacion VARCHAR2(50) NOT NULL,
    i_material_principal  VARCHAR2(100) NOT NULL,
    CONSTRAINT pk_dato_item PRIMARY KEY (i_id_item),
    CONSTRAINT ck_estado_conservacion CHECK (i_estado_conservacion IN ('Casi Nuevo', 'Buen estado', 'Con desgaste'))
);

CREATE TABLE canal_venta (
    v_id_plataforma NUMBER GENERATED BY DEFAULT AS IDENTITY,
    v_plataforma    VARCHAR2(50) NOT NULL,
    v_tipo_atencion VARCHAR2(100) NOT NULL,
    CONSTRAINT pk_canal_venta PRIMARY KEY (v_id_plataforma),
    CONSTRAINT ck_plataforma CHECK (v_plataforma IN ('Instagram', 'Sitio Web', 'Showroom Físico', 'Whatsapp'))
);

CREATE TABLE kardex_moda_circular (
    kd_id_orden     NUMBER GENERATED BY DEFAULT AS IDENTITY,
    kd_id_cliente   NUMBER NOT NULL,
    kd_id_item      NUMBER NOT NULL,
    kd_id_canal     NUMBER NOT NULL,
    kd_fecha_pedido DATE NOT NULL,
    kd_precio_venta NUMBER(12, 2) NOT NULL,
    kd_costo_envio  NUMBER(12, 2) DEFAULT 0 NOT NULL,
    kd_total_pagado NUMBER(12, 2) GENERATED ALWAYS AS (kd_precio_venta + kd_costo_envio),
    CONSTRAINT pk_kardex_moda_circular PRIMARY KEY (kd_id_orden),
    CONSTRAINT ck_precio_venta CHECK (kd_precio_venta > 0),
    CONSTRAINT fk_kardex_cliente FOREIGN KEY (kd_id_cliente) REFERENCES dato_cliente (c_id_cliente),
    CONSTRAINT fk_kardex_item FOREIGN KEY (kd_id_item) REFERENCES dato_item (i_id_item),
    CONSTRAINT fk_kardex_canal FOREIGN KEY (kd_id_canal) REFERENCES canal_venta (v_id_plataforma)
);
